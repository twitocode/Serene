{
  "tasks": [
    {
      "name": "Run csharpier",
      "command": "csharpier",
      "args": ["format", "."],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.xml",
        "**/*.config"
      ]
    },
    {
      "name": "Run Biome Check",
      "command": "bun",
      "args": ["run", "check"],
      "cwd": "client",
      "include": ["client/**/*.{ts,tsx,js,jsx,json}"]
    }
  ]
}
