{
  "tasks": [
    {
      "name": "Run csharpier",
      "command": "csharpier",
      "args": ["format", "."],
      "include": [
        "**/*.cs",
        "**/*.csx",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.xml",
        "**/*.config"
      ]
    }
  ]
}
